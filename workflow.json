    {
      "parameters": {
        "jsCode": "// 1. Adzuna'dan gelen yeni temizlenmiş ilan listesini alıyoruz\nconst newJobs = $('JS: Clean & Normalize Data').first().json.jobs || [];\n\n// 2. Google Sheets'ten daha önce kaydedilmiş Job ID'leri alıyoruz\nconst existingRows = $('Google Sheets: Get Existing IDs').all();\nconst existingIds = existingRows.map(row => String(row.json['Job ID'])).filter(Boolean);\n\n// 3. Daha önce kaydedilmemiş olan SADECE YENİ ilanları filtreliyoruz\nconst filteredJobs = newJobs.filter(job => !existingIds.includes(String(job.id)));\n\n// 4. Eğer hiç yeni ilan yoksa akışı burada güvenli bir şekilde durduruyoruz\nif (filteredJobs.length === 0) {\n  return []; // n8n sonraki adımları (OpenAI, Telegram vb.) çalıştırmaz.\n}\n\n// 5. Yeni ilanları OpenAI'a toplu paket halinde gönderiyoruz\nreturn [{\n  json: {\n    jobs: filteredJobs,\n    total_jobs: filteredJobs.length\n  }\n}];"
      },
