    {
      "parameters": {
        "jsCode": "const rawInput = $input.all()[0].json;\n\n// Eğer gelen yanıt bir dizi değilse veya Adzuna çöküp HTML döndüyse akışı güvenli bir şekilde durdur\nif (!rawInput || !rawInput.results || !Array.isArray(rawInput.results)) {\n  console.log(\"Adzuna API yanıt vermedi veya hatalı veri döndü.\");\n  return []; \n// Akış burada güvenle durur, diğer node'lar tetiklenmez.\n}\n// n8n'in yeni versiyonlarında doğrudan $input.all() kullanılır.\nconst rawData = $input.all()[0].json;\n\n// Eğer results alanı yoksa veya boşsa hata almamak için kontrol\nif (!rawData || !rawData.results || !Array.isArray(rawData.results)) {\n  return [];\n}\n\n// 1. İlanları dönüştür ve temizle\nconst processedJobs = rawData.results.map(job => {\n  \n  // Maaş verisini profesyonel bir formata dönüştürelim\n  let salaryFormatted = \"Not Specified\";\n  if (job.salary_min && job.salary_max) {\n    salaryFormatted = `€${job.salary_min.toLocaleString()} - €${job.salary_max.toLocaleString()}`;\n  } else if (job.salary_min) {\n    salaryFormatted = `Min €${job.salary_min.toLocaleString()}`;\n  } else if (job.salary_max) {\n    salaryFormatted = `Max €${job.salary_max.toLocaleString()}`;\n  }\n\n  // Lokasyon bilgisini temiz bir string yapalım\n  const locationAreas = job.location?.area ? job.location.area.join(\" > \") : (job.location?.display_name || \"N/A\");\n\n  // Tarihi ISO'dan daha okunabilir YYYY-MM-DD HH:mm formatına dönüştürelim\n  const createdDate = job.created ? new Date(job.created).toISOString().replace('T', ' ').substring(0, 16) : null;\n\n  return {\n    id: job.id,\n    title: job.title?.trim() || \"Untitled Position\",\n    company: job.company?.display_name || \"Unknown Company\",\n    category: job.category?.label !== \"Unknown\" ? job.category?.label : \"General / Uncategorized\",\n    location: job.location?.display_name || \"N/A\",\n    location_hierarchy: locationAreas,\n    contract_type: job.contract_type || \"N/A\",\n    contract_time: job.contract_time || \"N/A\",\n    salary: salaryFormatted,\n    raw_salary_min: job.salary_min || null,\n    raw_salary_max: job.salary_max || null,\n    description: job.description ? job.description.replace(/…$/, \"...\").trim() : \"\",\n    apply_url: job.redirect_url,\n    posted_at: createdDate,\n    coordinates: {\n      lat: job.latitude || null,\n      lng: job.longitude || null\n    }\n  };\n});\n\n// 2. BATCH PROCESSING: Tüm ilanları tek bir dizi altında OpenAI'a paketleyip dönüyoruz\nreturn [{\n  json: {\n    jobs: processedJobs,\n    total_jobs: processedJobs.length\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
