    {
      "parameters": {
        "jsCode": "// 1. OpenAI çıktısını ve Filtrelenmiş ham verileri alıyoruz\nconst rawOutput = $input.all()[0].json.output;\nconst filteredOriginalJobs = $('JS: Filter New Jobs Only').first().json.jobs;\n\nlet analyzedJobs = [];\n\ntry {\n  const cleanedText = rawOutput.replace(/```json/g, '').replace(/```/g, '').trim();\n  analyzedJobs = JSON.parse(cleanedText);\n} catch (error) {\n  throw new Error(\"OpenAI çıktısı geçerli bir JSON dizisi formatında değil: \" + error.message);\n}\n\n// 2. OpenAI analizi ile orijinal verileri ID üzerinden eşleştirip birleştiriyoruz\nreturn analyzedJobs.map(aiJob => {\n  const matchingOriginal = filteredOriginalJobs.find(orig => String(orig.id) === String(aiJob.id)) || {};\n  \n  return {\n    json: {\n      ...aiJob,\n      location: matchingOriginal.location || \"N/A\",\n      salary: matchingOriginal.salary || \"Not Specified\",\n      apply_url: matchingOriginal.apply_url || \"\",\n      company: matchingOriginal.company || aiJob.sirket\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
